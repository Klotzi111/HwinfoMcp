<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>HwinfoMcp</AssemblyName>
		<RootNamespace>HwinfoMcp</RootNamespace>
		<VersionPrefix>0.1.0</VersionPrefix>
		<Product>hwinfo-mcp-dotnet</Product>
		<Description>MCP server (stdio) that exposes live HWiNFO sensor data read from HWiNFO's shared memory.</Description>
	</PropertyGroup>

	<PropertyGroup Label="Native AOT">
		<!-- Set here rather than only in the publish profile so the AOT and trim analyzers run on every build -->
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Hwinfo.SharedMemory.Net" />
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="ModelContextProtocol" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="HwinfoMcp.Tests" />
	</ItemGroup>

</Project>

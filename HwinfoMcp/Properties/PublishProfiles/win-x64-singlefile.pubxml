<?xml version="1.0" encoding="utf-8"?>
<!--
	Local build for machines with the .NET 10 runtime: a framework-dependent single-file HwinfoMcp.exe,
	no Native AOT, no MSVC linker needed. The dotnet tool (install-local.ps1) is the more convenient way
	to run a local build, as it is found without a path.
	dotnet publish HwinfoMcp/HwinfoMcp.csproj -p:PublishProfile=win-x64-singlefile
-->
<Project>
	<PropertyGroup>
		<Configuration>Release</Configuration>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<PublishAot>false</PublishAot>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishDir>$(MSBuildProjectDirectory)\..\artifacts\publish\win-x64-singlefile\</PublishDir>
		<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
	</PropertyGroup>
</Project>

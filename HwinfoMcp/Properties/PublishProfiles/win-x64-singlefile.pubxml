<?xml version="1.0" encoding="utf-8"?>
<!--
	Fallback for machines without the MSVC linker that Native AOT needs: a self-contained, trimmed
	single-file HwinfoMcp.exe. Also runs without a .NET installation, but is larger and starts slower.
	dotnet publish HwinfoMcp/HwinfoMcp.csproj -p:PublishProfile=win-x64-singlefile
-->
<Project>
	<PropertyGroup>
		<Configuration>Release</Configuration>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishAot>false</PublishAot>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishTrimmed>true</PublishTrimmed>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<PublishDir>$(MSBuildProjectDirectory)\..\artifacts\publish\win-x64-singlefile\</PublishDir>
		<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
	</PropertyGroup>
</Project>

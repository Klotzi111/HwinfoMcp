<?xml version="1.0" encoding="utf-8"?>
<!--
	Native AOT build for Windows on ARM: a single HwinfoMcp.exe that runs without a .NET installation.
	dotnet publish HwinfoMcp/HwinfoMcp.csproj -p:PublishProfile=win-arm64
	Needs the MSVC linker with the ARM64 build tools ("C++ ARM64 build tools" of Visual Studio or the
	VS Build Tools). CI builds it on a Windows ARM64 runner.
-->
<Project>
	<PropertyGroup>
		<Configuration>Release</Configuration>
		<RuntimeIdentifier>win-arm64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishAot>true</PublishAot>
		<PublishDir>$(MSBuildProjectDirectory)\..\artifacts\publish\win-arm64\</PublishDir>
		<!-- Only the exe: the symbols stay in the build output -->
		<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
	</PropertyGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<!--
	Native AOT build: a single HwinfoMcp.exe that runs without a .NET installation.
	dotnet publish HwinfoMcp/HwinfoMcp.csproj -p:PublishProfile=win-x64
	Needs the MSVC linker ("Desktop development with C++" workload or the VS Build Tools).
-->
<Project>
	<PropertyGroup>
		<Configuration>Release</Configuration>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishAot>true</PublishAot>
		<PublishDir>$(MSBuildProjectDirectory)\..\artifacts\publish\win-x64\</PublishDir>
		<!-- Only the exe: the symbols stay in the build output -->
		<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
	</PropertyGroup>
</Project>
